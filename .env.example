# TestInsight API Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# REPORTPORTAL CONFIGURATION
# =============================================================================
# Your ReportPortal instance URL (required)
REPORTPORTAL_URL=https://reportportal.example.com

# ReportPortal API token for authentication (required)
# Get this from your ReportPortal user profile
REPORTPORTAL_API_TOKEN=your_reportportal_api_token_here

# Default project to sync (optional)
# If not specified, will sync all accessible projects
REPORTPORTAL_PROJECT=your_project_name

# =============================================================================
# API SERVER CONFIGURATION
# =============================================================================
# Host address for the API server
API_HOST=0.0.0.0

# Port for the API server
API_PORT=8000

# Enable debug mode for development
API_DEBUG=false

# Log level for the application
API_LOG_LEVEL=INFO

# Log format (json or console)
API_LOG_FORMAT=json

# CORS allowed origins (comma-separated)
# Use * for development, specific domains for production
API_CORS_ORIGINS=*

# Maximum request size in bytes
API_MAX_REQUEST_SIZE=10485760

# Request timeout in seconds
API_REQUEST_TIMEOUT=300

# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================
# Primary LLM provider (openai, anthropic, or ollama)
LLM_PROVIDER=openai

# General LLM settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Ollama Configuration (for local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# =============================================================================
# VECTOR DATABASE CONFIGURATION
# =============================================================================
# ChromaDB persistence directory
CHROMA_PERSIST_DIRECTORY=./chroma_db

# ChromaDB collection name
CHROMA_COLLECTION_NAME=reportportal_data

# Embedding model for vector generation
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Embedding batch size for processing
EMBEDDING_BATCH_SIZE=32

# =============================================================================
# DATA SYNCHRONIZATION CONFIGURATION
# =============================================================================
# Batch size for API requests to ReportPortal
SYNC_BATCH_SIZE=100

# Rate limit for API requests (requests per second)
SYNC_RATE_LIMIT=10

# Request timeout for sync operations (seconds)
SYNC_TIMEOUT=30

# Maximum retry attempts for failed requests
SYNC_MAX_RETRIES=3

# Enable incremental synchronization
ENABLE_INCREMENTAL_SYNC=true

# Enable full synchronization
ENABLE_FULL_SYNC=true

# =============================================================================
# RAG (RETRIEVAL AUGMENTED GENERATION) CONFIGURATION
# =============================================================================
# Default number of documents to retrieve for context
RAG_N_RESULTS=20

# Include raw search results in responses by default
RAG_INCLUDE_RAW_RESULTS=false

# =============================================================================
# AUTHENTICATION & SECURITY (Future Use)
# =============================================================================
# API key for authentication (not currently implemented)
# API_KEY=your_api_key_here

# JWT secret for token authentication (not currently implemented)
# JWT_SECRET=your_jwt_secret_here

# JWT token expiration time in seconds (not currently implemented)
# JWT_EXPIRATION=3600

# Enable API rate limiting (not currently implemented)
# ENABLE_RATE_LIMITING=false

# Rate limit per minute per IP (not currently implemented)
# RATE_LIMIT_PER_MINUTE=100

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Enable metrics collection
ENABLE_METRICS=false

# Metrics endpoint path
METRICS_ENDPOINT=/metrics

# Enable health check endpoint
ENABLE_HEALTH_CHECK=true

# Health check endpoint path
HEALTH_CHECK_ENDPOINT=/health

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# =============================================================================
# SLACK BOT INTEGRATION (Optional)
# =============================================================================
# Slack bot token for integration (optional)
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Slack signing secret for webhook verification (optional)
# SLACK_SIGNING_SECRET=your_slack_signing_secret

# Default channel for notifications (optional)
# SLACK_DEFAULT_CHANNEL=#test-insights

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================
# Enable development mode features
DEV_MODE=false

# Enable API documentation endpoints
ENABLE_DOCS=true

# Custom Swagger UI title
SWAGGER_TITLE=TestInsight API

# Enable ReDoc documentation
ENABLE_REDOC=true

# Enable OpenAPI JSON endpoint
ENABLE_OPENAPI_JSON=true

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# Worker processes for production deployment
WORKERS=1

# Worker connections per process
WORKER_CONNECTIONS=1000

# Keep alive timeout for connections
KEEP_ALIVE_TIMEOUT=65

# Maximum concurrent requests
MAX_CONCURRENT_REQUESTS=100

# Connection pool size for HTTP clients
CONNECTION_POOL_SIZE=20

# =============================================================================
# CACHING (Future Use)
# =============================================================================
# Enable response caching (not currently implemented)
# ENABLE_CACHING=false

# Cache TTL in seconds (not currently implemented)
# CACHE_TTL=300

# Cache backend (memory, redis) (not currently implemented)
# CACHE_BACKEND=memory

# Redis URL for caching (not currently implemented)
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# DATABASE BACKUP & MAINTENANCE
# =============================================================================
# Enable automatic backups of vector database
ENABLE_AUTO_BACKUP=false

# Backup interval in hours
BACKUP_INTERVAL_HOURS=24

# Backup retention days
BACKUP_RETENTION_DAYS=7

# Backup directory path
BACKUP_DIRECTORY=./backups

# =============================================================================
# EXTERNAL INTEGRATIONS (Future Use)
# =============================================================================
# Webhook URL for notifications (not currently implemented)
# WEBHOOK_URL=https://your-webhook-endpoint.com/notify

# Email configuration for notifications (not currently implemented)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_email_password
# EMAIL_FROM=testinsight@example.com

# =============================================================================
# CUSTOM CONFIGURATION
# =============================================================================
# Custom API title for branding
CUSTOM_API_TITLE=TestInsight API

# Custom API description
CUSTOM_API_DESCRIPTION=AI-powered ReportPortal test analytics

# Custom API version
CUSTOM_API_VERSION=0.1.0

# Custom contact information
CONTACT_NAME=TestInsight Support
CONTACT_EMAIL=support@testinsight.example.com
CONTACT_URL=https://github.com/your-org/testinsight

# License information
LICENSE_NAME=MIT
LICENSE_URL=https://opensource.org/licenses/MIT
